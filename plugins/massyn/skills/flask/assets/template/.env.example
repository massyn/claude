SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=sqlite:////data/myapp/app.db
FORCE_HTTPS=true
APP_HOSTNAME=myapp.example.com,www.myapp.example.com   # comma-separated allow-list
VERSION=1.0.0

# Email sign-in (the default). Without these the login page says email sign-in is not configured.
MAILGUN_API_KEY=your-mailgun-api-key
MAILGUN_DOMAIN=mg.example.com
MAILGUN_FROM=My App <login@mg.example.com>
# MAILGUN_BASE_URL=https://api.eu.mailgun.net   # EU-region Mailgun accounts only
# OTP_TTL_SECONDS=600       # how long an emailed code works
# OTP_MAX_ATTEMPTS=5        # wrong guesses before a code is void
# ALLOW_SIGNUP=false        # true: any verified email may create an account. False: only people in the users table

# PASSKEY_SIGNUP=false       # true: visitors can create an account with a passkey alone. Only if the app demands it

# Breakglass admin: this email is always an admin and may sign in without a users row. Lower-cased.
ADMIN_USER=you@example.com

# Optional Google sign-in: the button appears only when GOOGLE_CLIENT_ID is set.
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret

# PASSKEY_RP_ID=myapp.example.com   # domain passkeys belong to; defaults to the first APP_HOSTNAME. Must be a name, not an IP: use localhost in development
# PASSKEY_RP_NAME=My App            # name shown when a user creates a passkey
# FLASK_PORT=5000   # dev server port. Omit in production.
# TEST_USER=alice@example.com   # DEV ONLY: this email signs in with no code. The login page shows "TEST_USER active"
